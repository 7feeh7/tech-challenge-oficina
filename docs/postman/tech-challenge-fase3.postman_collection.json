{
  "info": {
    "name": "Tech Challenge Fase 3 — Oficina",
    "description": "Coleção mínima para demonstração: auth CPF, login interno e OS protegida. Defina `api_gateway_url` no environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "api_gateway_url", "value": "https://SUBSTITUA.execute-api.us-east-1.amazonaws.com" },
    { "key": "cliente_token", "value": "" },
    { "key": "interno_token", "value": "" },
    { "key": "demo_os_id", "value": "55555555-5555-4555-8555-555555555001" }
  ],
  "item": [
    {
      "name": "Auth CPF — cliente ativo",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cpf\": \"529.982.247-25\"\n}"
        },
        "url": "{{api_gateway_url}}/auth/cpf"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.collectionVariables.set('cliente_token', body.accessToken);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth CPF — cliente inativo (401)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cpf\": \"390.533.447-05\"\n}"
        },
        "url": "{{api_gateway_url}}/auth/cpf"
      }
    },
    {
      "name": "Login interno — admin",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@oficina.com\",\n  \"senha\": \"SENHA_DO_SECRET\"\n}"
        },
        "url": "{{api_gateway_url}}/v1/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "  const body = pm.response.json();",
              "  pm.collectionVariables.set('interno_token', body.token || body.accessToken);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "GET OS — token cliente (ownership)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{cliente_token}}" }],
        "url": "{{api_gateway_url}}/v1/ordens-servico/{{demo_os_id}}"
      }
    },
    {
      "name": "GET OS — sem token (401)",
      "request": {
        "method": "GET",
        "url": "{{api_gateway_url}}/v1/ordens-servico/{{demo_os_id}}"
      }
    },
    {
      "name": "PATCH OS — mudança de status (interno)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{interno_token}}" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Correlation-Id", "value": "demo-{{$timestamp}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"AGUARDANDO_APROVACAO\"\n}"
        },
        "url": "{{api_gateway_url}}/v1/ordens-servico/{{demo_os_id}}"
      }
    },
    {
      "name": "Health — Gateway",
      "request": {
        "method": "GET",
        "url": "{{api_gateway_url}}/health"
      }
    }
  ]
}

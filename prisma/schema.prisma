// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PerfilUsuario {
  ADMINISTRADOR
  ATENDENTE
  MECANICO
  ALMOXARIFE
}

model Cliente {
  id           String    @id @default(uuid()) @db.Uuid
  nome         String
  cpfCnpj      String    @unique
  email        String    @unique
  telefone     String
  veiculos     Veiculo[]
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")

  @@map("clientes")
}

model Veiculo {
  id           String   @id @default(uuid()) @db.Uuid
  placa        String   @unique
  marca        String
  modelo       String
  ano          Int
  clienteId    String   @map("cliente_id") @db.Uuid
  cliente      Cliente  @relation(fields: [clienteId], references: [id])
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([clienteId])
  @@map("veiculos")
}

model Usuario {
  id           String        @id @default(uuid()) @db.Uuid
  nome         String
  email        String        @unique
  senhaHash    String        @map("senha_hash")
  ativo        Boolean       @default(true)
  perfil       PerfilUsuario
  criadoEm     DateTime      @default(now()) @map("criado_em")
  atualizadoEm DateTime      @updatedAt @map("atualizado_em")

  @@map("usuarios")
}

model Servico {
  id               String   @id @default(uuid()) @db.Uuid
  nome             String   @unique
  descricao        String?
  precoBase        Decimal  @map("preco_base") @db.Decimal(10, 2)
  tempoEstimadoMin Int      @map("tempo_estimado_min")
  ativo            Boolean  @default(true)
  criadoEm        DateTime @default(now()) @map("criado_em")
  atualizadoEm    DateTime @updatedAt @map("atualizado_em")

  @@map("servicos")
}

model Peca {
  id                String   @id @default(uuid()) @db.Uuid
  codigo            String   @unique
  nome              String
  descricao         String?
  precoUnitario     Decimal  @map("preco_unitario") @db.Decimal(10, 2)
  quantidadeEstoque Int      @default(0) @map("quantidade_estoque")
  estoqueMinimo     Int      @default(0) @map("estoque_minimo")
  ativo             Boolean  @default(true)
  criadoEm         DateTime @default(now()) @map("criado_em")
  atualizadoEm     DateTime @updatedAt @map("atualizado_em")

  @@map("pecas")
}


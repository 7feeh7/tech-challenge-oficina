# Banco de dados (PostgreSQL)
POSTGRES_USER=oficina
POSTGRES_PASSWORD=oficina
POSTGRES_DB=oficina
POSTGRES_PORT=5432

# Connection string utilizada pelo Prisma
DATABASE_URL="postgresql://oficina:oficina@localhost:5432/oficina?schema=public"

# Em produção o Amazon RDS recusa conexão sem TLS, e o ConfigMap do k8s liga isto.
DATABASE_SSL=false

# API
PORT=3000

# Observabilidade (Datadog / dd-trace)
DD_SERVICE=oficina-api
DD_ENV=development
DD_VERSION=0.0.1
DD_RUNTIME_METRICS=true
DD_TRACE_ENABLED=true
DD_LOGS_INJECTION=true

# JWT
JWT_SECRET=troque-este-segredo-em-producao-local
JWT_ISSUER=tech-challenge-auth
JWT_AUDIENCE=tech-challenge-api

# Usuário administrador inicial (criado automaticamente no primeiro boot,
# apenas se ainda não existir nenhum ADMINISTRADOR no banco)
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@oficina.com
ADMIN_SENHA=admin12345

# Notificações de status da OS (local: log; sendgrid: e-mail direto; sns: mensageria AWS).
NOTIFICACAO_TRANSPORT=local
AWS_REGION=us-east-1
SNS_NOTIFICACAO_TOPIC_ARN=

# SendGrid — usado apenas com NOTIFICACAO_TRANSPORT=sendgrid (dev legado).
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=oficina@seu-dominio.com

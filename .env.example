# Banco de dados (PostgreSQL)
POSTGRES_USER=oficina
POSTGRES_PASSWORD=oficina
POSTGRES_DB=oficina
POSTGRES_PORT=5432

# Connection string utilizada pelo Prisma
DATABASE_URL="postgresql://oficina:oficina@localhost:5432/oficina?schema=public"

# API
PORT=3000

# JWT
JWT_SECRET=troque-este-segredo-em-producao

# Usuário administrador inicial (criado automaticamente no primeiro boot,
# apenas se ainda não existir nenhum ADMINISTRADOR no banco)
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@oficina.com
ADMIN_SENHA=admin12345

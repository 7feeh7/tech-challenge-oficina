# Banco de dados (PostgreSQL)
POSTGRES_USER=oficina
POSTGRES_PASSWORD=oficina
POSTGRES_DB=oficina
POSTGRES_PORT=5432

# Connection string utilizada pelo Prisma
DATABASE_URL="postgresql://oficina:oficina@localhost:5432/oficina?schema=public"

# Em produção o Amazon RDS recusa conexão sem TLS, e o ConfigMap do k8s liga isto.
DATABASE_SSL=false

# Pool explícito no driver pg (D5.5): até 5 conexões por processo
DATABASE_POOL_MAX=5
DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000
DATABASE_TRANSACTION_TIMEOUT_MS=10000

# API
PORT=3000

# Observabilidade (Datadog / dd-trace)
DD_SERVICE=oficina-api
DD_ENV=development
DD_VERSION=0.0.1
DD_RUNTIME_METRICS=true
DD_TRACE_ENABLED=true
DD_LOGS_INJECTION=true

# JWT (RS256 — chave privada só no OS e auth-cpf; pública no Billing/Execution)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=tech-challenge-auth
JWT_AUDIENCE=tech-challenge-api

# Tokens por relação chamador → OS (E08)
TOKEN_BILLING_OS=
TOKEN_EXECUTION_OS=
TOKEN_AUTH_CPF_OS=

# Usuário administrador inicial (criado automaticamente no primeiro boot,
# apenas se ainda não existir nenhum ADMINISTRADOR no banco)
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@oficina.com
ADMIN_SENHA=admin12345

# Notificações de status da OS (local: log; sendgrid: e-mail direto; sns: mensageria AWS).
NOTIFICACAO_TRANSPORT=local
AWS_REGION=us-east-1
SNS_NOTIFICACAO_TOPIC_ARN=

# Mensageria SQS / outbox (processadores desligados por padrão)
SQS_OS_IN_URL=
SQS_OS_IN_DLQ_URL=
SQS_BILLING_IN_URL=
SQS_EXECUTION_IN_URL=
SQS_CONSUMER_HABILITADO=false
SQS_CONSUMER_INTERVAL_MS=1000
SQS_CONSUMER_LOTE=3
SQS_LONG_POLL_SECONDS=10
SQS_CONNECTION_TIMEOUT_MS=5000
# Uma tentativa HTTP; deve ser >= SQS_LONG_POLL_SECONDS*1000.
SQS_HTTP_ATTEMPT_TIMEOUT_MS=12000
# Prazo total por operação (retentativas do SDK dentro deste AbortSignal).
SQS_OPERATION_DEADLINE_MS=45000
SNS_CONNECTION_TIMEOUT_MS=5000
SNS_HTTP_ATTEMPT_TIMEOUT_MS=12000
SNS_OPERATION_DEADLINE_MS=45000
AWS_SDK_MAX_ATTEMPTS=3
OUTBOX_PUBLISHER_HABILITADO=false
OUTBOX_PUBLISHER_INTERVAL_MS=2000
OUTBOX_PUBLISHER_LOTE=5
OUTBOX_PERSISTENCIA_MS=5000
# Mín. 260s pior caso publicador (+ margem); ver docs/local/mensageria-processadores-os.md.
OUTBOX_REIVINDICACAO_MS=300000
OUTBOX_RETRY_BASE_MS=1000
OUTBOX_RETRY_TETO_MS=300000

# SendGrid — usado apenas com NOTIFICACAO_TRANSPORT=sendgrid (dev legado).
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=oficina@seu-dominio.com